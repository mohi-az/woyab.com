{
  "name": "@fargo/database",
  "version": "1.0.0",
  "description": "Database package for Fargo - Prisma schema, migrations, and generated client.",
  "main": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./client": {
      "types": "./generated/prisma/client.ts",
      "default": "./generated/prisma/client.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:push:dev": "dotenv -e .env.development -- prisma db push",
    "db:migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "db:push": "dotenv -e .env.production -- prisma db push",
    "db:migrate": "dotenv -e .env.production -- prisma migrate dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
