model LocationCatalogEntry {
  id             Int                       @id @default(autoincrement())
  source         String
  sourceId       String
  name           String
  asciiName      String?
  alternateNames String[]                  @default([])
  searchText     String
  featureCode    String
  kind           LocationCatalogKind
  countryCode    String                    @default("DE")
  admin1Code     String?
  admin1Name     String?
  parentName     String?
  latitude       Float
  longitude      Float
  geoPoint       Unsupported("geography")? @default(dbgenerated("(st_setsrid(st_makepoint(longitude, latitude), 4326))::geography")) @map("geo_point")
  population     BigInt                    @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @default(now()) @updatedAt

  @@unique([source, sourceId])
  @@index([countryCode, kind])
  @@map("location_catalog_entries")
}

enum LocationCatalogKind {
  CITY
  DISTRICT
  LOCALITY

  @@map("location_catalog_kind")
}
