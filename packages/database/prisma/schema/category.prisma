model Category {
  id            Int           @id @default(autoincrement())
  nameFa        String
  nameEn        String
  slug          String        @unique
  icon          String?
  image         String?
  sortOrder     Int           @default(0)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  businesses    Business[]
  subCategories SubCategory[]

  @@map("categories")
}

model SubCategory {
  id          Int         @id @default(autoincrement())
  nameFa      String
  nameEn      String
  slug        String      @unique
  icon        String?
  image       String?
  categoryId  Int
  sortOrder   Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  businesses  Business[]
  category    Category    @relation(fields: [categoryId], references: [id])

  @@map("sub_categories")
}
