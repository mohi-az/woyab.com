model Category {
  id          Int           @id @default(autoincrement())
  nameFa      String
  nameEn      String
  slug        String        @unique
  icon        String?
  image       String?
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subCategories     SubCategory[]
  businesses        Business[]
  attributeDefs     AttributeDefinition[]

  @@map("categories")
}

model SubCategory {
  id          Int          @id @default(autoincrement())
  nameFa      String
  nameEn      String
  slug        String       @unique
  icon        String?
  image       String?
  categoryId  Int
  category    Category     @relation(fields: [categoryId], references: [id])
  sortOrder   Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  specialties   Specialty[]
  businesses    Business[]
  attributeDefs AttributeDefinition[]

  @@map("sub_categories")
}

/// Optional specialization for a professional sub-category.
model Specialty {
  id            Int         @id @default(autoincrement())
  nameFa        String
  nameEn        String?
  subCategoryId Int
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])
  sortOrder     Int         @default(0)
  active        Boolean     @default(true)

  businesses    Business[]

  @@map("specialties")
}
