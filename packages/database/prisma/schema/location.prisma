model Country {
  id        Int        @id @default(autoincrement())
  nameFa    String
  nameEn    String
  code      String     @unique // ISO 3166-1 alpha-2, e.g. "DE"
  active    Boolean    @default(true)

  provinces Province[]

  @@map("countries")
}

model Province {
  id        Int      @id @default(autoincrement())
  nameFa    String
  nameEn    String
  slug      String   @unique
  countryId Int
  country   Country  @relation(fields: [countryId], references: [id])

  cities    City[]

  @@map("provinces")
}

model City {
  id         Int        @id @default(autoincrement())
  nameFa     String
  nameEn     String
  slug       String     @unique
  provinceId Int
  province   Province   @relation(fields: [provinceId], references: [id])
  latitude   Float?
  longitude  Float?

  districts  District[]
  businesses Business[]
  branches   Branch[]
  businessLocations BusinessLocation[]
  savedLocations    UserSavedLocation[]

  @@map("cities")
}

model District {
  id      Int     @id @default(autoincrement())
  nameFa  String
  nameEn  String?
  cityId  Int
  city    City    @relation(fields: [cityId], references: [id])

  businesses Business[]
  branches   Branch[]
  businessLocations BusinessLocation[]
  savedLocations    UserSavedLocation[]

  @@map("districts")
}
