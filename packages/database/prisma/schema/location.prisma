model Country {
  id        Int        @id @default(autoincrement())
  nameFa    String
  nameEn    String
  code      String     @unique
  active    Boolean    @default(true)
  provinces Province[]

  @@map("countries")
}

model Province {
  id        Int     @id @default(autoincrement())
  nameFa    String
  nameEn    String
  slug      String  @unique
  countryId Int
  cities    City[]
  country   Country @relation(fields: [countryId], references: [id])

  @@map("provinces")
}

model City {
  id         Int        @id @default(autoincrement())
  nameFa     String
  nameEn     String
  slug       String     @unique
  provinceId Int
  latitude   Float?
  longitude  Float?
  branches   Branch[]
  businesses Business[]
  province   Province   @relation(fields: [provinceId], references: [id])
  districts  District[]

  @@map("cities")
}

model District {
  id         Int        @id @default(autoincrement())
  nameFa     String
  nameEn     String?
  cityId     Int
  branches   Branch[]
  businesses Business[]
  city       City       @relation(fields: [cityId], references: [id])

  @@map("districts")
}
