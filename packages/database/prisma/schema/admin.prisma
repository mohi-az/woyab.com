enum DirectoryReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED

  @@map("directory_report_status")
}

enum BusinessClaimStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("business_claim_status")
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED

  @@map("contact_message_status")
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED

  @@map("support_ticket_status")
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("support_ticket_priority")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model DirectoryReport {
  id             String                @id @default(cuid())
  businessId     String?
  business       Business?             @relation(fields: [businessId], references: [id], onDelete: SetNull)
  reviewId       String?
  review         Review?               @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  reporterUserId String?
  reporter       User?                 @relation("DirectoryReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reason         String
  message        String?
  status         DirectoryReportStatus @default(OPEN)
  resolvedById   String?
  resolvedBy     User?                 @relation("DirectoryReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([businessId])
  @@index([reviewId])
  @@index([reporterUserId])
  @@index([status])
  @@map("directory_reports")
}

model BusinessClaim {
  id             String              @id @default(cuid())
  businessId     String
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  claimantUserId String?
  claimant       User?               @relation("BusinessClaimClaimant", fields: [claimantUserId], references: [id], onDelete: SetNull)
  claimantName   String
  claimantEmail  String
  claimantPhone  String?
  message        String?
  status         BusinessClaimStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?               @relation("BusinessClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([businessId])
  @@index([claimantUserId])
  @@index([status])
  @@map("business_claims")
}

model ContactMessage {
  id           String               @id @default(cuid())
  businessId   String
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String?
  message      String
  status       ContactMessageStatus @default(NEW)
  deliveryMode String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([businessId])
  @@index([status])
  @@map("contact_messages")
}

model SupportTicket {
  id           String                @id @default(cuid())
  userId       String?
  user         User?                 @relation("SupportTicketUser", fields: [userId], references: [id], onDelete: SetNull)
  subject      String
  message      String
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(NORMAL)
  assignedToId String?
  assignedTo   User?                 @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@map("support_tickets")
}

model AdminSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation("AdminSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedById])
  @@map("admin_settings")
}
