enum AiProvider {
  OPENAI
  GEMINI

  @@map("ai_provider")
}

enum AiBusinessImportStatus {
  QUEUED
  FETCHING_GOOGLE
  FETCHING_WEBSITE
  ANALYZING
  READY
  FAILED
  APPLIED
  DISCARDED

  @@map("ai_business_import_status")
}

model AiProviderConfig {
  provider        AiProvider @id
  enabled         Boolean    @default(false)
  isDefault       Boolean    @default(false)
  apiKeyEncrypted String?
  apiKeyHint      String?
  model           String?
  systemPrompt    String?    @db.Text
  temperature     Float?
  maxOutputTokens Int        @default(2048)
  timeoutMs       Int        @default(30000)
  updatedById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  updatedBy       User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([isDefault], map: "ai_provider_configs_one_default", where: raw("\"isDefault\" = true"))
  @@index([updatedById])
  @@map("ai_provider_configs")
}

model AiBusinessImport {
  id                String                 @id @default(cuid())
  placeId           String
  status            AiBusinessImportStatus @default(QUEUED)
  provider          AiProvider
  model             String
  createdById       String
  appliedBusinessId String?                @unique
  googleSnapshot    Json?
  websiteEvidence   Json?
  proposal           Json?
  reviewState        Json?
  warnings           Json?
  errorCode          String?
  errorMessage       String?
  requestId          String?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  attemptCount       Int                    @default(0)
  leaseExpiresAt     DateTime?
  completedAt        DateTime?
  appliedAt          DateTime?
  expiresAt          DateTime
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt
  createdBy          User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  appliedBusiness    Business?              @relation(fields: [appliedBusinessId], references: [id], onDelete: SetNull)

  @@index([createdById, createdAt])
  @@index([placeId, status])
  @@index([status, leaseExpiresAt])
  @@index([expiresAt])
  @@map("ai_business_imports")
}
