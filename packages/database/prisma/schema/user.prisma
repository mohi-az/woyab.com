// User and authentication.

enum UserRole {
  USER
  OWNER
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
}

model User {
  id          String    @id @default(cuid())
  phone       String?   @unique
  email       String?   @unique
  emailVerified DateTime?
  passwordHash String?
  passwordChangedAt DateTime?
  authVersion Int       @default(0)
  name        String?
  avatarUrl   String?
  role        UserRole  @default(USER)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  businesses  Business[]
  reviews     Review[]
  favorites   Favorite[]
  savedLocations UserSavedLocation[]
  passwordResetTokens PasswordResetToken[]
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")
  directoryReports DirectoryReport[] @relation("DirectoryReportReporter")
  resolvedDirectoryReports DirectoryReport[] @relation("DirectoryReportResolver")
  businessClaims BusinessClaim[] @relation("BusinessClaimClaimant")
  reviewedBusinessClaims BusinessClaim[] @relation("BusinessClaimReviewer")
  supportTickets SupportTicket[] @relation("SupportTicketUser")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignee")
  updatedAdminSettings AdminSetting[] @relation("AdminSettingUpdater")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Favorite {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, businessId])
  @@index([businessId])
  @@map("favorites")
}
