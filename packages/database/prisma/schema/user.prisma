model User {
  id                       String              @id @default(cuid())
  phone                    String?             @unique
  email                    String?             @unique
  name                     String?
  avatarUrl                String?
  role                     UserRole            @default(USER)
  active                   Boolean             @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  emailVerified            DateTime?
  passwordHash             String?
  passwordChangedAt        DateTime?
  authVersion              Int                 @default(0)
  adminAuditLogs           AdminAuditLog[]
  adminSettings            AdminSetting[]
  businessClaims           BusinessClaim[]     @relation("BusinessClaimClaimant")
  reviewedBusinessClaims   BusinessClaim[]     @relation("BusinessClaimReviewer")
  businesses               Business[]
  directoryReports         DirectoryReport[]   @relation("DirectoryReportReporter")
  resolvedDirectoryReports DirectoryReport[]   @relation("DirectoryReportResolver")
  favorites                Favorite[]
  reviewOwnerReplies       ReviewOwnerReply[]
  reviews                  Review[]
  assignedSupportTickets   SupportTicket[]     @relation("SupportTicketAssignee")
  supportTickets           SupportTicket[]     @relation("SupportTicketUser")
  supportTicketReplies     SupportTicketReply[]
  savedLocations           UserSavedLocation[]

  @@map("users")
}

enum UserRole {
  USER
  OWNER
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
}
