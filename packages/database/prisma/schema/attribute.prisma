/// Defines a possible business attribute such as parking, delivery, or online booking.
model AttributeDefinition {
  id        Int                 @id @default(autoincrement())
  key       String              @unique
  labelFa   String
  labelEn   String?
  labelDe   String?
  dataType  AttributeDataType
  unit      String?
  options   String?
  sortOrder Int                 @default(0)
  active    Boolean             @default(true)
  values    BusinessAttribute[]

  @@map("attribute_definitions")
}

/// Stores the value of an attribute for a specific business.
model BusinessAttribute {
  id          Int                 @id @default(autoincrement())
  businessId  String
  attributeId Int
  value       String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, attributeId])
  @@map("business_attributes")
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  DATE

  @@map("attribute_data_type")
}
