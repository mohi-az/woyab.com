# Neon pooled connection string (Project dashboard -> Connect -> Pooled connection)
DATABASE_URL="postgresql://NEON_USER:NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=verify-full&channel_binding=require"
AUTH_SECRET="generate-with-npx-auth-secret"

# Enable Google in Firebase Authentication, then copy the Web client OAuth values
# from the linked Google Cloud project. NextAuth remains the session authority.
AUTH_GOOGLE_ID="your-google-web-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-web-client-secret"

# Authorized redirect URI in Google Cloud / Firebase-linked OAuth client:
# http://localhost:3000/api/auth/callback/google

# Public URL used in password setup/reset emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP mailer for password setup/reset links and business-claim OTPs.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_STARTTLS="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="WoYab <no-reply@example.com>"

# Optional public legal contact details. Complete these before a public launch.
LEGAL_CONTROLLER_NAME=""
LEGAL_CONTROLLER_ADDRESS=""
PRIVACY_EMAIL=""
PRIVACY_SUPERVISORY_AUTHORITY=""
PRIVACY_SUPERVISORY_AUTHORITY_URL=""

# Required when the business-claim feature is enabled in production.
CLAIM_PRIVACY_NOTICE_VERSION="2026-07-13"
CLAIM_TERMS_VERSION="2026-07-13"

# Protect the scheduled OTP-expiry/retention maintenance endpoint.
CRON_SECRET=""

# Shared server-to-server credential for quota-bearing API routes.
# Generate a random value of at least 32 characters and set the same value on the API.
INTERNAL_API_SECRET=""

# Optional persistent volume path for owner uploads and permanent business covers.
# The directory must be writable by the frontend server.
BUSINESS_IMAGE_STORAGE_DIR=""

# Hashes persistent anti-abuse identifiers and encrypts administrator TOTP secrets.
ABUSE_RATE_LIMIT_SECRET=""
TWO_FACTOR_ENCRYPTION_KEY=""

# Encrypts AI provider API keys saved by the super-admin panel.
# Generate a unique random secret of at least 32 characters and keep it stable.
AI_CONFIG_ENCRYPTION_KEY=""

# Resend notification sent after a message is stored in a business owner's inbox.
RESEND_API_KEY=""
BUSINESS_CONTACT_FROM_EMAIL="WoYab <business-messages@example.com>"

# Sentry error monitoring.
# NEXT_PUBLIC_SENTRY_DSN is public and used by browser monitoring.
# SENTRY_DSN is used by server and edge monitoring.
# SENTRY_AUTH_TOKEN is a secret build-time token for source map uploads.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
